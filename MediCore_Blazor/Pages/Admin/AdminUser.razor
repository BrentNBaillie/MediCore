@page "/admin-user"

@using MediCore_Blazor.Services
@using MediCore_Library.Models.DTOs.DTO_Entities
@using MediCore_Library.Models.Identities
@inject HttpClient http
@inject GlobalConfig config
@inject NavigationManager nav
@inject SessionState state

<div class="page-container">
    <div class="page-title-bar">
        <div>
            <h2>User Management</h2>
            <p class="page-subtitle">Directory and account metrics across all clinical roles</p>
        </div>
    </div>

    <div class="metrics-row">
        <div class="metric-card">
            <span class="metric-label">Total Registered Users</span>
            <span class="metric-value">@count</span>
        </div>
    </div>
</div>

@code {
    private int count = 0;

    protected override async Task OnInitializedAsync()
    {
        count = await http.GetFromJsonAsync<int>($"{config.BaseUrl}/admin/user-count");
    }
}