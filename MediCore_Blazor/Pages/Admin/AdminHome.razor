@page "/admin"

@using MediCore_Blazor.Services
@using MediCore_Library.Models.DTOs.DTO_Entities
@using MediCore_Library.Models.Identities
@inject HttpClient http
@inject GlobalConfig config
@inject NavigationManager nav
@inject SessionState state

<div class="dashboard-container">
    <div class="dashboard-header">
        <div>
            <h2>System Overview</h2>
            <p class="dashboard-subtitle">Real-time clinical metrics and employment cost analytics</p>
        </div>
        <button class="btn-danger" @onclick="DeleteAll">Clear Database</button>
    </div>

    <div class="system-counts">
        <div class="stat-card">
            <span class="stat-label">Users</span>
            <span class="stat-value">@counts.Users</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Doctors</span>
            <span class="stat-value">@counts.Doctors</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Nurses</span>
            <span class="stat-value">@counts.Nurses</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Patients</span>
            <span class="stat-value">@counts.Patients</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Addresses</span>
            <span class="stat-value">@counts.Addresses</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Appointments</span>
            <span class="stat-value">@counts.Appointments</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Bills</span>
            <span class="stat-value">@counts.Bills</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Chats</span>
            <span class="stat-value">@counts.Chats</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Medical Records</span>
            <span class="stat-value">@counts.MedicalRecords</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Medicines</span>
            <span class="stat-value">@counts.Medicines</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Prescriptions</span>
            <span class="stat-value">@counts.Prescriptions</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Schedules</span>
            <span class="stat-value">@counts.Schedules</span>
        </div>
        <div class="stat-card">
            <span class="stat-label">Feedbacks</span>
            <span class="stat-value">@counts.Feedbacks</span>
        </div>
    </div>

    <div class="salaries-section">
        <div class="table-card">
            <div class="table-header">
                <h3>Total Yearly Employment Costs</h3>
            </div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Doctors</th>
                        <th>Nurses</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@salaries.TotalDoctorSalaries.ToString("C")</td>
                        <td>@salaries.TotalNurseSalaries.ToString("C")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private SystemCountsDTO counts = new();
    private TotalSalariesDTO salaries = new();

    protected override async Task OnInitializedAsync()
    {
        var countResult = await http.GetFromJsonAsync<SystemCountsDTO>($"{config.BaseUrl}/admin/count");
        if (countResult is not null)
        {
            counts = countResult;
        }

        var salaryResult = await http.GetFromJsonAsync<TotalSalariesDTO>($"{config.BaseUrl}/admin/salaries");
        if (salaryResult is not null)
        {
            salaries = salaryResult;
        }
    }

    private async Task DeleteAll()
    {
        await http.DeleteAsync($"{config.BaseUrl}/authorize");
        counts = new();
        salaries = new();
        StateHasChanged();
    }
}